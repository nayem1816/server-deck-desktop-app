{
  "name": "@serverdeck/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "ServerDeck desktop app",
  "author": "ServerDeck",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:electron": "node scripts/build-electron.mjs",
    "build:web": "next build web",
    "build": "pnpm build:web && pnpm build:electron",
    "start": "electron .",
    "dist": "pnpm build && electron-builder",
    "typecheck": "tsc --noEmit -p tsconfig.electron.json && tsc --noEmit -p web/tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-slot": "^1.4.0",
    "@serverdeck/shared": "workspace:^",
    "@tailwindcss/postcss": "4",
    "@tanstack/react-query": "^5.104.1",
    "@types/react": "19",
    "@types/react-dom": "19",
    "@types/ssh2": "^1.15.6",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.55.0",
    "next": "15",
    "postcss": "^8.5.29",
    "react": "19",
    "react-dom": "19",
    "sonner": "^2.0.8",
    "ssh2": "^1.17.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "4",
    "vitest": "^3.0.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.15"
  },
  "build": {
    "appId": "app.serverdeck.desktop",
    "productName": "ServerDeck",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist-electron/**",
      "!dist-electron/**/*.map",
      "web/out/**",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "icon": "build/icon.png"
    }
  }
}
