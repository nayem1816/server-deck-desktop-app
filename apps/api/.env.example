NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/server-deck
# 32+ random characters each: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
SERVER_SECRET=
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
# Required in production. Without it (dev only), reset codes are printed to the log.
# Gmail: use an App Password (Google Account → Security → App passwords), not your login password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=
MAIL_FROM=ServerDeck <you@gmail.com>
